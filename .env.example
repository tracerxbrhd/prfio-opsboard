# Local Docker demonstration. Replace all values for a public deployment.
POSTGRES_DB=opsboard
POSTGRES_USER=opsboard
POSTGRES_PASSWORD=local-opsboard-only
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
SEED_DEMO=true
DEMO_PASSWORD=demo-password
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
WEB_PORT=8081
LOG_LEVEL=INFO
